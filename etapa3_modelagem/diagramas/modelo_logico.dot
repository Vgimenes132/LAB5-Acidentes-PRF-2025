digraph logico {
layout=neato; splines=true; pad=0.4; bgcolor=white;
label=<<B>Modelo Lógico (esquema estrela, Oracle)</B><BR/><FONT POINT-SIZE="12">PK chave primária | FK chave estrangeira | UK única | NN obrigatória | CK regra CHECK</FONT>>;
labelloc=t; fontname="DejaVu Sans"; fontsize=20;
node [fontname="DejaVu Sans", fontsize=11];
edge [color="#555555", penwidth=1.4, dir=both, arrowtail=crow, arrowhead=teetee, arrowsize=1.1];
fato_acidente [shape=plain, pos="0,0.00!", label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#B5651D"><TR><TD COLSPAN="3" BGCOLOR="#B5651D"><FONT COLOR="white"><B>FATO_ACIDENTE</B></FONT></TD></TR><TR><TD PORT="id_ocorrencia_w" ALIGN="LEFT" BGCOLOR="#FFF4CC"><FONT POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id_ocorrencia</B></TD><TD PORT="id_ocorrencia_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(10)</FONT></TD></TR><TR><TD PORT="sk_data_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>FK NN</B></FONT></TD><TD ALIGN="LEFT">sk_data</TD><TD PORT="sk_data_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(8)</FONT></TD></TR><TR><TD PORT="sk_horario_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>FK NN</B></FONT></TD><TD ALIGN="LEFT">sk_horario</TD><TD PORT="sk_horario_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(4)</FONT></TD></TR><TR><TD PORT="sk_localidade_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>FK NN</B></FONT></TD><TD ALIGN="LEFT">sk_localidade</TD><TD PORT="sk_localidade_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(6)</FONT></TD></TR><TR><TD PORT="sk_unidade_prf_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>FK NN</B></FONT></TD><TD ALIGN="LEFT">sk_unidade_prf</TD><TD PORT="sk_unidade_prf_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(6)</FONT></TD></TR><TR><TD PORT="sk_causa_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>FK NN</B></FONT></TD><TD ALIGN="LEFT">sk_causa</TD><TD PORT="sk_causa_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(6)</FONT></TD></TR><TR><TD PORT="sk_tipo_acidente_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>FK NN</B></FONT></TD><TD ALIGN="LEFT">sk_tipo_acidente</TD><TD PORT="sk_tipo_acidente_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(6)</FONT></TD></TR><TR><TD PORT="sk_meteorologia_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>FK NN</B></FONT></TD><TD ALIGN="LEFT">sk_meteorologia</TD><TD PORT="sk_meteorologia_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(6)</FONT></TD></TR><TR><TD PORT="sk_condicao_via_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>FK NN</B></FONT></TD><TD ALIGN="LEFT">sk_condicao_via</TD><TD PORT="sk_condicao_via_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(6)</FONT></TD></TR><TR><TD PORT="sk_tracado_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>FK NN</B></FONT></TD><TD ALIGN="LEFT">sk_tracado</TD><TD PORT="sk_tracado_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(6)</FONT></TD></TR><TR><TD PORT="nr_br_w" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT">nr_br</TD><TD PORT="nr_br_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(3)</FONT></TD></TR><TR><TD PORT="nr_km_w" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT">nr_km</TD><TD PORT="nr_km_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(6,1)</FONT></TD></TR><TR><TD PORT="nr_latitude_w" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT">nr_latitude</TD><TD PORT="nr_latitude_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(12,10)</FONT></TD></TR><TR><TD PORT="nr_longitude_w" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT">nr_longitude</TD><TD PORT="nr_longitude_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(12,10)</FONT></TD></TR><TR><TD PORT="qt_pessoas_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>NN CK</B></FONT></TD><TD ALIGN="LEFT">qt_pessoas</TD><TD PORT="qt_pessoas_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(4)</FONT></TD></TR><TR><TD PORT="qt_mortos_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>NN CK</B></FONT></TD><TD ALIGN="LEFT">qt_mortos</TD><TD PORT="qt_mortos_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(4)</FONT></TD></TR><TR><TD PORT="qt_feridos_leves_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>NN CK</B></FONT></TD><TD ALIGN="LEFT">qt_feridos_leves</TD><TD PORT="qt_feridos_leves_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(4)</FONT></TD></TR><TR><TD PORT="qt_feridos_graves_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>NN CK</B></FONT></TD><TD ALIGN="LEFT">qt_feridos_graves</TD><TD PORT="qt_feridos_graves_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(4)</FONT></TD></TR><TR><TD PORT="qt_ilesos_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>NN CK</B></FONT></TD><TD ALIGN="LEFT">qt_ilesos</TD><TD PORT="qt_ilesos_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(4)</FONT></TD></TR><TR><TD PORT="qt_ignorados_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>NN CK</B></FONT></TD><TD ALIGN="LEFT">qt_ignorados</TD><TD PORT="qt_ignorados_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(4)</FONT></TD></TR><TR><TD PORT="qt_veiculos_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>NN CK</B></FONT></TD><TD ALIGN="LEFT">qt_veiculos</TD><TD PORT="qt_veiculos_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(4)</FONT></TD></TR><TR><TD PORT="dt_carga_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>NN</B></FONT></TD><TD ALIGN="LEFT">dt_carga</TD><TD PORT="dt_carga_e" ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD></TR></TABLE>>];
dim_data [shape=plain, pos="-6.2,3.82!", label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#1F4E79"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>DIM_DATA</B></FONT></TD></TR><TR><TD PORT="sk_data_w" ALIGN="LEFT" BGCOLOR="#FFF4CC"><FONT POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>sk_data</B></TD><TD PORT="sk_data_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(8)</FONT></TD></TR><TR><TD PORT="dt_data_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>UK</B></FONT></TD><TD ALIGN="LEFT">dt_data</TD><TD PORT="dt_data_e" ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD></TR><TR><TD PORT="nr_ano_w" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT">nr_ano</TD><TD PORT="nr_ano_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(4)</FONT></TD></TR><TR><TD PORT="nr_semestre_w" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT">nr_semestre</TD><TD PORT="nr_semestre_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(1)</FONT></TD></TR><TR><TD PORT="nr_trimestre_w" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT">nr_trimestre</TD><TD PORT="nr_trimestre_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(1)</FONT></TD></TR><TR><TD PORT="nr_mes_w" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT">nr_mes</TD><TD PORT="nr_mes_e" ALIGN="LEFT"><FONT COLOR="#555555">NUMBER(2)</FONT></TD></TR><TR><TD PORT="nm_mes_w" ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="10"><B>NN</B></FONT></TD><TD ALIGN="LEFT">nm_mes</TD><TD PORT="nm_mes_e" ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR2(15)</FONT></TD></TR><TR><TD PORT="nm_mes_abrev_w" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT">nm_mes_abrev</TD><TD PORT="nm_mes_abrev_e" ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR2(3)</FONT></TD></TR><TR><TD PORT="ds_ano_mes_w" ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT">ds_ano_mes</TD><TD PORT="ds_ano_mes_e" ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR2(7)</FONT></TD></TR><TR><TD PORT="nr_dia_w" ALIGN="LEFT" BGCOLOR="white"> </TD><TD